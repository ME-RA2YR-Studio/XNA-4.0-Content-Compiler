# Normalize line endings in the repository; Windows sources check out as CRLF.
* text=auto

*.cs         text eol=crlf
*.csproj     text eol=crlf
*.props      text eol=crlf
*.slnx       text eol=crlf
*.manifest   text eol=crlf
*.ps1        text eol=crlf
*.bat        text eol=crlf
*.json       text eol=crlf
*.md         text eol=crlf
LICENSE      text eol=crlf
*.gitignore  text eol=crlf
*.gitattributes text eol=crlf

# Binary assets
*.ico binary
*.png binary
*.jpg binary
*.dll binary
*.exe binary
*.xnb binary
